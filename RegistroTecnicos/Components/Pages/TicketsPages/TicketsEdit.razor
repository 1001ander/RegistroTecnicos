@page "/Tickets/Edit/{TicketId:int}"
@using RegistroTecnicos.Models
@using RegistroTecnicos.Services
@using Blazored.Toast
@using Blazored.Toast.Services
@inject TicketsService ticketsService
@inject ClientesService clientesService
@inject TecnicosService tecnicosService
@inject IToastService toastService
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@rendermode InteractiveServer

<PageTitle>Editar Ticket</PageTitle>

<EditForm Model="Ticket" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center bg-primary text-white">
                <h5 class="card-title">Editar Ticket</h5>
            </div>

            <div class="card-body">
                @*Campo Fecha*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Ticket.Fecha" />
                    <ValidationMessage For="@(() => Ticket.Fecha)" />
                </div>

                @*Campo Cliente*@
                <div class="mb-3">
                    <label class="form-label"><strong>Cliente</strong></label>
                    <InputSelect class="form-select" @bind-Value="Ticket.ClienteId">
                        <option value="">Seleccione un cliente...</option>
                        @foreach (var cliente in ListaClientes)
                        {
                            <option value="@cliente.ClienteId">@cliente.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Ticket.ClienteId)" />
                </div>

                @*Campo Técnico*@
                <div class="mb-3">
                    <label class="form-label"><strong>Técnico</strong></label>
                    <InputSelect class="form-select" @bind-Value="Ticket.TecnicoId">
                        <option value="">Seleccione un técnico...</option>
                        @foreach (var tecnico in ListaTecnicos)
                        {
                            <option value="@tecnico.TecnicoId">@tecnico.Nombres</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="@(() => Ticket.TecnicoId)" />
                </div>

                @*Campo Prioridad*@
                <div class="mb-3">
                    <label class="form-label"><strong>Prioridad</strong></label>
                    <InputSelect class="form-select" @bind-Value="Ticket.Prioridad">
                        <option value="Alta">Alta</option>
                        <option value="Media">Media</option>
                        <option value="Baja">Baja</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Ticket.Prioridad)" />
                </div>

                @*Campo Asunto*@
                <div class="mb-3">
                    <label class="form-label"><strong>Asunto</strong></label>
                    <InputText class="form-control" @bind-Value="Ticket.Asunto" />
                    <ValidationMessage For="@(() => Ticket.Asunto)" />
                </div>

                @*Campo Descripción*@
                <div class="mb-3">
                    <label class="form-label"><strong>Descripción</strong></label>
                    <InputTextArea class="form-control" @bind-Value="Ticket.Descripcion" rows="4" />
                    <ValidationMessage For="@(() => Ticket.Descripcion)" />
                </div>

                @*Campo Tiempo Invertido*@
                <div class="mb-3">
                    <label class="form-label"><strong>Tiempo Invertido (horas)</strong></label>
                    <InputNumber class="form-control" @bind-Value="Ticket.TiempoInvertido" />
                    <ValidationMessage For="@(() => Ticket.TiempoInvertido)" />
                </div>
            </div>

            <div class="card-footer text-center">
                <button type="button" class="btn btn-secondary me-2" @onclick="Volver">
                    <i class="bi bi-arrow-left"></i> Volver
                </button>
                <button type="submit" class="btn btn-success me-2">
                    <i class="bi bi-check-circle"></i> Guardar
                </button>
                <button type="button" class="btn btn-outline-danger" @onclick="Eliminar">
                    <i class="bi bi-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int TicketId { get; set; }

    public Tickets Ticket { get; set; } = new Tickets();
    public List<Clientes> ListaClientes { get; set; } = new();
    public List<Tecnicos> ListaTecnicos { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Ticket = await ticketsService.Buscar(TicketId) ?? new Tickets();
            ListaClientes = await clientesService.Listar(c => c.ClienteId > 0);
            ListaTecnicos = await tecnicosService.Listar(t => t.TecnicoId > 0);
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error al cargar datos: {ex.Message}");
        }
    }

    private void Volver()
    {
        navigationManager.NavigateTo("/Tickets/Index");
    }

    private async Task Guardar()
    {
        try
        {
            var resultado = await ticketsService.Guardar(Ticket);

            if (resultado)
            {
                toastService.ShowSuccess("Ticket actualizado correctamente");
                navigationManager.NavigateTo("/Tickets/Index");
            }
            else
            {
                toastService.ShowError("No se pudo actualizar el ticket");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error: {ex.Message}");
        }
    }

    private async Task Eliminar()
    {
        try
        {
            var confirmado = await jsRuntime.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este ticket?");
            if (!confirmado) return;

            var eliminado = await ticketsService.Eliminar(Ticket.TicketId);

            if (eliminado)
            {
                toastService.ShowSuccess("Ticket eliminado correctamente");
                navigationManager.NavigateTo("/Tickets/Index");
            }
            else
            {
                toastService.ShowError("No se pudo eliminar el ticket");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error al eliminar: {ex.Message}");
        }
    }
}