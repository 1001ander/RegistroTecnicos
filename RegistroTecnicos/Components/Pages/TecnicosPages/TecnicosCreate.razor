@page "/Tecnicos/Create"
@using RegistroTecnicos.Models
@using RegistroTecnicos.Services
@using Blazored.Toast
@using Blazored.Toast.Services
@inject TecnicosService tecnicosService
@inject NavigationManager navigationManager
@inject IToastService toastService

<PageTitle>Crear Técnico</PageTitle>

<EditForm Model="tecnico" OnValidSubmit="Guardar" FormName="formCrearTecnico">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            @*Header*@
            <div class="card-header text-center bg-primary text-white">
                <h5 class="card-title">Crear Técnico</h5>
            </div>

            @*Body*@
            <div class="card-body">
                @*Nombres*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="tecnico.Nombres" />
                    <ValidationMessage For="@(() => tecnico.Nombres)" />
                </div>

                @*Sueldo Hora*@
                <div class="mb-3">
                    <label class="form-label"><strong>Sueldo por Hora</strong></label>
                    <InputNumber class="form-control" @bind-Value="tecnico.SueldoHora" />
                    <ValidationMessage For="@(() => tecnico.SueldoHora)" />
                </div>
            </div>

            @*Footer*@
            <div class="card-footer text-center mt-2 bg-light">
                <a href="/Tecnicos/Index" class="btn btn-secondary me-2">
                    <i class="bi bi-arrow-left"></i> Volver
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-floppy"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private Tecnicos tecnico { get; set; } = new Tecnicos();

    private async Task Guardar()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(tecnico.Nombres))
            {
                toastService.ShowWarning("El nombre no puede estar vacío");
                return;
            }

            if (await tecnicosService.ExisteTecnico(tecnico.TecnicosId, tecnico.Nombres!))
            {
                toastService.ShowError("Ya existe un técnico con este nombre");
                return;
            }

            var resultado = await tecnicosService.Guardar(tecnico);

            if (resultado)
            {
                toastService.ShowSuccess("Técnico creado exitosamente");
                navigationManager.NavigateTo("/Tecnicos/Index");
            }
            else
            {
                toastService.ShowError("Error al guardar el técnico");
            }
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error inesperado: {ex.Message}");
        }
    }
}