@page "/Tecnicos/Index"
@using RegistroTecnicos.Services
@using RegistroTecnicos.Models
@inject TecnicosService tecnicosService
@inject NavigationManager navigationManager
@rendermode InteractiveServer


<PageTitle>Consulta de tecnicos</PageTitle>

    <div class="card-header bg-primary text-center text-white py-2 rounded">
        <h3 style="font-weight: bold;" class="font-weight-bold">Consulta de T&eacute;cnicos</h3>
    </div>

    <div class="col md-3 text-end">
        <a href="/Tecnico/Create" class="btn btn-success"<Icon Name="IconName.Pencil"/>Crear</a>
    </div>

    <table class="table table-bordered text-center">
        <thead class="bg-primary">
            <tr>
                <th class="text-black">T&eacute;cnicoId</th>
            <th class="text-black">Nombres</th>
            <th class="text-black">SueldoHora</th>
            <th class="text-black">Editar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tecnicos in ListaTecnicos)
            {
                <tr>
                    <td>@tecnicos.TecnicosId</td>
                    <td>@tecnicos.Nombres</td>
                    <td>@tecnicos.SueldoHora</td>
                    <td>
                        <a href="/Tecnico/Edit/@tecnicos.TecnicosId" class="btn btn-outline-secondary" style="color: #FF7043; border-color: #FF7043;" onmouseover="this.style.backgroundColor='#FF7043'; this.style.color='#FFFFFF';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#FF7043';"><span class="bi bi-pencil"></span></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-footer text-start">
        <p>Total de T&eacute;cnicos: @ListaTecnicos.Count</p>

    </div>

@code {
    public List<Tecnicos> ListaTecnicos { get; set; } = new List<Tecnicos>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaTecnicos = await tecnicosService.Listar(t => t.TecnicosId > 0);
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(ValorFiltro))
        {
            ListaTecnicos = await tecnicosService.Listar(t => t.TecnicosId > 0);
            return;
        }

        if (Filtro == "Id" && int.TryParse(ValorFiltro, out int tecnicoId))
        {
            ListaTecnicos = await tecnicosService.Listar(t => t.TecnicosId == tecnicoId);
        }
        else if (Filtro == "Nombres")
        {
            ListaTecnicos = await tecnicosService.Listar(t =>
                t.Nombres.Contains(ValorFiltro, StringComparison.OrdinalIgnoreCase));
        }
    }
}