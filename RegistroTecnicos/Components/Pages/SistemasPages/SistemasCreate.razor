@page "/Sistemas/Create"
@using RegistroTecnicos.Models
@using RegistroTecnicos.Services
@using Blazored.Toast.Services

@inject SistemasService SistemasService
@inject NavigationManager NavigationManager
@inject IToastService ToastService

@rendermode InteractiveServer

<PageTitle>Registrar Sistema</PageTitle>

<EditForm Model="Sistema" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center bg-primary text-white">
                <h5 class="card-title">Nuevo Sistema</h5>
            </div>

            <div class="card-body">
                @* Descripción *@
                <div class="mb-3">
                    <label class="form-label"><strong>Descripción</strong></label>
                    <InputText class="form-control" @bind-Value="Sistema.Descripcion" />
                    <ValidationMessage For="@(() => Sistema.Descripcion)" />
                </div>

                @* Complejidad *@
                <div class="mb-3">
                    <label class="form-label"><strong>Complejidad</strong></label>
                    <InputSelect class="form-select" @bind-Value="Sistema.Complejidad">
                        <option value="">Seleccione una complejidad</option>
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => Sistema.Complejidad)" />
                </div>
            </div>

            <div class="card-footer text-center">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-secondary me-2" @onclick="Volver">
                        <i class="bi bi-arrow-left"></i> Volver
                    </button>
                    <button type="submit" class="btn btn-outline-success me-2">
                        <i class="bi bi-check-circle"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-outline-primary" @onclick="LimpiarFormulario">
                        <i class="bi bi-eraser"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private Sistemas Sistema { get; set; } = new Sistemas();

    private async Task Guardar()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Sistema.Descripcion))
            {
                ToastService.ShowWarning("La descripción es obligatoria.");
                return;
            }

            if (string.IsNullOrWhiteSpace(Sistema.Complejidad))
            {
                ToastService.ShowWarning("Debe seleccionar una complejidad.");
                return;
            }

            var resultado = await SistemasService.Guardar(Sistema);

            if (resultado)
            {
                ToastService.ShowSuccess("Sistema registrado exitosamente.");
                await Task.Delay(1500);
                NavigationManager.NavigateTo("/Sistemas/Index");
            }
            else
            {
                ToastService.ShowError("No se pudo registrar el sistema.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error al guardar: {ex.Message}");
        }
    }

    private void Volver() => NavigationManager.NavigateTo("/Sistemas/Index");

    private void LimpiarFormulario() => Sistema = new Sistemas();
}
